# Reserved for when Django settings are moved to environment configuration.
# DEBUG=False
# SECRET_KEY=replace-with-a-local-development-secret

POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=secret

# S3-compatible media storage. Leave STORAGE_BACKEND unset to use the local
# filesystem. These example endpoints assume Django runs directly on the host.
STORAGE_BACKEND=storages.backends.s3.S3Storage
STORAGE_ACCESS_KEY_ID=replace-with-application-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-a-long-random-application-secret
STORAGE_BUCKET_NAME=uzshop-media
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000/uzshop-media
STORAGE_REGION_NAME=us-east-1
STORAGE_ADDRESSING_STYLE=path
STORAGE_QUERYSTRING_AUTH=False
STORAGE_FILE_OVERWRITE=False
FILE_STORAGE_ALIASES=default
