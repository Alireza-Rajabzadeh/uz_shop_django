#: backend/domains/catalog/services/detail_service.py:24
#, python-brace-format
msgid "'{value}' is not a valid option. Choices: {choices}"
msgstr "'{value}' یک گزینه معتبر نیست. گزینه‌ها: {choices}"

#: backend/domains/customer/serializers/customer.py:22
msgid "Phone number already registered."
msgstr "شماره تلفن قبلاً ثبت شده است."

#: backend/domains/customer/serializers/customer.py:27
msgid "Passwords do not match."
msgstr "رمز عبور مطابقت ندارد."

#: backend/domains/customer/services/auth_service.py:26
#: backend/domains/customer/services/auth_service.py:29
msgid "Invalid phone number or password."
msgstr "شماره تلفن یا رمز عبور اشتباه است."

#: backend/domains/customer/services/auth_service.py:32
msgid "Account is inactive."
msgstr "حساب کاربری غیرفعال است."

msgid "Please wait before requesting another code."
msgstr "لطفاً پیش از درخواست کد جدید کمی صبر کنید."

#, python-format
msgid "Your UzShop login confirmation code is %(code)s. It expires in %(minutes)s minutes."
msgstr "کد تایید ورود شما به ازشاپ %(code)s است. این کد تا %(minutes)s دقیقه معتبر است."

msgid "The confirmation code could not be sent."
msgstr "ارسال کد تایید انجام نشد."

msgid "The confirmation code is invalid or expired."
msgstr "کد تایید نامعتبر است یا منقضی شده است."

msgid "The confirmation request is no longer valid."
msgstr "درخواست تایید دیگر معتبر نیست."

msgid "Confirmation code sent."
msgstr "کد تایید ارسال شد."

msgid "Enter a valid mobile number."
msgstr "شماره موبایل معتبر وارد کنید."

#, python-format
msgid "Your UzShop password reset code is %(code)s. It expires in %(minutes)s minutes."
msgstr "کد بازیابی رمز عبور شما در ازشاپ %(code)s است. این کد تا %(minutes)s دقیقه معتبر است."

msgid "If an eligible account exists, a confirmation code has been sent."
msgstr "اگر حساب واجد شرایطی وجود داشته باشد، کد تایید ارسال شده است."

msgid "Password reset successful."
msgstr "بازیابی رمز عبور با موفقیت انجام شد."

msgid "Phone number is already verified."
msgstr "شماره موبایل قبلاً تایید شده است."

#, python-format
msgid "Your UzShop phone verification code is %(code)s. It expires in %(minutes)s minutes."
msgstr "کد تایید شماره موبایل شما در ازشاپ %(code)s است. این کد تا %(minutes)s دقیقه معتبر است."

msgid "Phone number verified."
msgstr "شماره موبایل تایید شد."

#: backend/domains/customer/views.py:28
msgid "Registration successful."
msgstr "ثبت نام با موفقیت انجام شد."

#: backend/domains/customer/views.py:44
msgid "Login successful."
msgstr "ورود با موفقیت انجام شد."

#: backend/domains/customer/views.py:61
msgid "Profile updated."
msgstr "پروفایل به‌روزرسانی شد."

#: backend/domains/customer/views.py:81
msgid "Address created."
msgstr "آدرس ایجاد شد."

#: backend/domains/customer/views.py:91
msgid "Address not found."
msgstr "آدرس پیدا نشد."

#: backend/domains/customer/views.py:108
msgid "Address updated."
msgstr "آدرس به‌روزرسانی شد."

#: backend/domains/customer/views.py:114
msgid "Address deleted."
msgstr "آدرس حذف شد."

#: backend/domains/customer/views.py:135
msgid "Preferences updated."
msgstr "تنظیمات به‌روزرسانی شد."

#: backend/domains/users/services/auth_service.py:12
msgid "Invalid username or password."
msgstr "نام کاربری یا رمز عبور اشتباه است."

#: backend/domains/users/services/auth_service.py:15
msgid "User account is inactive."
msgstr "حساب کاربری غیرفعال است."

#: backend/domains/users/services/auth_service.py:18
msgid "You do not have permission to access this resource."
msgstr "شما مجوز دسترسی به این منبع را ندارید."

#: domains/catalog/services/product_service.py
msgid "One or more details are not assigned to the selected category."
msgstr "یک یا چند جزئیات به دسته‌بندی انتخاب‌شده اختصاص ندارند."

#: domains/catalog/services/product_service.py
#, python-brace-format
msgid "Required product details are missing: {names}."
msgstr "جزئیات الزامی محصول وارد نشده‌اند: {names}."

#: domains/catalog/services/product_service.py
#, python-brace-format
msgid "'{value}' is not valid for {name}."
msgstr "مقدار '{value}' برای {name} معتبر نیست."

#: domains/catalog/services/product_service.py
#, python-brace-format
msgid "{name} must be a number."
msgstr "{name} باید عدد باشد."

#: domains/catalog/services/product_service.py
#, python-brace-format
msgid "{name} must be a finite number."
msgstr "{name} باید یک عدد متناهی باشد."

#: domains/catalog/services/product_service.py
msgid "Each product detail can only be submitted once."
msgstr "هر جزئیات محصول فقط یک بار قابل ارسال است."

msgid "No active payment channel is available."
msgstr "در حال حاضر کانال پرداخت فعالی وجود ندارد."
